const slug = (value: string) => value.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "");
const memberNames = members.map((member) => member.name);
const memberKeywords = members.flatMap((member) => [member.role, ...member.tags, ...member.achievements]);
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": "https://spectrasec.id/#organization",
      name: "SpectraSec.id",
      alternateName: ["SpectraSec", "SpectraSec Cyber Security Community"],
      url: "https://spectrasec.id",
      logo: "https://spectrasec.id/images/spectrasec-logo.jpg",
      sameAs: [instagramUrl, telegramUrl],
      description: "Komunitas belajar dan media edukasi keamanan cyber Indonesia dengan fokus ethical hacking, web security, bug hunting, OSINT, dan responsible disclosure.",
      member: members.map((member) => ({
        "@type": "Person",
        name: member.name,
        jobTitle: member.role,
        roleName: member.role,
        description: member.summary,
        award: member.achievements,
        knowsAbout: [...member.tags, ...member.achievements],
        image: member.image ? `https://spectrasec.id${member.image}` : undefined,
        sameAs: member.links.map((link) => link[1]),
      })),
    },
    {
      "@type": "WebSite",
      "@id": "https://spectrasec.id/#website",
      url: "https://spectrasec.id",
      name: "SpectraSec.id",
      publisher: { "@id": "https://spectrasec.id/#organization" },
      inLanguage: "id-ID",
      keywords: ["SpectraSec", "SpectraSec.id", "komunitas cybersecurity Indonesia", "ethical hacking", "bug hunting", "NASA Letter of Recognition", "KOMDIGI-CSIRT", "Nokia CVD Hall of Fame", ...memberNames],
    },
    {
      "@type": "ItemList",
      "@id": "https://spectrasec.id/#core-members",
      name: "Core Members SpectraSec.id",
      itemListElement: members.map((member, index) => ({
        "@type": "ListItem",
        position: index + 1,
        url: `https://spectrasec.id/#${slug(member.name)}`,
        item: {
          "@type": "Person",
          name: member.name,
          jobTitle: member.role,
          roleName: member.role,
          description: member.summary,
          award: member.achievements,
          knowsAbout: [...member.tags, ...member.achievements],
          image: member.image ? `https://spectrasec.id${member.image}` : undefined,
          sameAs: member.links.map((link) => link[1]),
        },
      })),
    },
  ],
};

const title = "SpectraSec.id | Komunitas Cyber Security & Ethical Hacking Indonesia";
const description = "SpectraSec.id adalah komunitas belajar keamanan cyber Indonesia untuk ethical hacking, web security, bug hunting, OSINT, Linux, dan responsible disclosure bersama core member SpectraSec.";
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={`SpectraSec, SpectraSec.id, komunitas cybersecurity Indonesia, ethical hacking Indonesia, bug hunting Indonesia, web security, OSINT, responsible disclosure, ${memberNames.join(", ")}, ${memberKeywords.join(", ")}`} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <link rel="canonical" href="https://spectrasec.id/" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="id_ID" />
    <meta property="og:site_name" content="SpectraSec.id" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content="https://spectrasec.id/" />
    <meta property="og:image" content="https://spectrasec.id/images/spectrasec-hero.webp" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://spectrasec.id/images/spectrasec-hero.webp" />
    <link rel="preload" as="image" href="/images/spectrasec-hero.webp" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body>
    <header class="site-header" data-header>
      <a class="brand" href="#top" aria-label="SpectraSec.id beranda">
        <img class="brand-logo" src="/images/spectrasec-logo.jpg" alt="" width="64" height="64" loading="eager" decoding="async" />
        <span>SPECTRASEC<span>.ID</span></span>
      </a>
      <nav class="desktop-nav" aria-label="Navigasi utama">
        <a href="#tentang">Tentang</a>
        <a href="#materi">Insight</a>
        <a href="#tim">Tim</a>
        <a href="#instruktur">Instruktur</a>
      </nav>
      <a class="header-cta magnetic" href={telegramUrl} target="_blank" rel="noreferrer">Gabung Komunitas <span aria-hidden="true">↗</span></a>
      <button class="menu-button" data-menu-button aria-label="Buka navigasi" aria-expanded="false"><span></span><span></span></button>
      <nav class="mobile-nav" data-mobile-nav aria-label="Navigasi mobile" hidden>
        <a href="#tentang">Tentang</a>
        <a href="#materi">Insight</a>
        <a href="#tim">Tim</a>
        <a href="#instruktur">Instruktur</a>
        <a href={telegramUrl} target="_blank" rel="noreferrer">Gabung Komunitas</a>
      </nav>
    </header>

    <main id="top">
      <section class="hero" aria-labelledby="hero-heading">
        <img class="hero-image" src="/images/spectrasec-hero.webp" alt="Security researcher memantau jaringan dari pusat operasi keamanan" width="1568" height="1003" loading="eager" decoding="async" />
        <div class="hero-shade"></div>
        <div class="hero-grid-bg"></div>
        <div class="hero-content">
          <p class="hero-kicker"><span class="status-dot"></span>ETHICAL HACKING · VDP · BUG BOUNTY</p>
          <div class="hero-mobile-orbit" aria-hidden="true">
            <span class="signal-mark"><i></i><i></i><i></i><i></i><b></b></span>
          </div>
          <h1 id="hero-heading">SpectraSec.id<br /><span>Cyber research collective.</span></h1>
          <p class="hero-copy">Ruang belajar, riset, dan publikasi keamanan siber untuk talenta Indonesia yang bergerak di jalur legal: dari fundamental sampai responsible disclosure.</p>
          <div class="hero-actions">
            <a class="btn-primary magnetic" href={telegramUrl} target="_blank" rel="noreferrer">Gabung Komunitas <span>→</span></a>
            <a class="btn-secondary magnetic" href="#materi">Pelajari Materi</a>
          </div>
        </div>
        <div class="hero-status" aria-label="Status komunitas">
          <span><i></i>COMMUNITY ONLINE</span>
          <span>BASED IN INDONESIA</span>
          <span>ETHICAL BY DEFAULT</span>
        </div>
      </section>

      <section class="proof-section full-bleed-section" aria-label="SpectraSec proof points">
        <div class="container wide-container">
          <div class="proof-grid">
            {proofPoints.map((point) => (
              <article class="proof-card">
                <span class="proof-meta">{point.meta}</span>
                <strong>{point.title}</strong>
                <p>{point.desc}</p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section id="tentang" class="section-pad about-section full-bleed-section">
        <div class="container wide-container">
          <div class="section-title reveal">
            <div>
              <p class="eyebrow"><span></span>Tentang SpectraSec</p>
              <h2>Disiplin teknis sebelum eksploitasi.</h2>
            </div>
            <p>SpectraSec.id membedah konsep keamanan siber menjadi materi yang terarah, relevan, dan aman dipraktikkan. Fokusnya jelas: belajar dalam scope legal, memahami dampak, lalu melaporkan dengan etika.</p>
          </div>
          <div class="values-grid">
            <article class="value-panel magnetic">
              <span class="value-index">01</span>
              <div class="icon-box">ED</div>
              <h3>Edukasi Terarah</h3>
              <p>Mulai dari fundamental Linux dan jaringan, berlanjut ke web security, vulnerability research, dan responsible disclosure.</p>
              <ul><li>Konsep sebelum tools</li><li>Materi dasar hingga advanced</li></ul>
            </article>
            <article class="value-panel magnetic">
              <span class="value-index">02</span>
              <div class="icon-box cyan">SC</div>
              <h3>Sharing Community</h3>
              <p>Ruang terbuka bagi pemula dan security researcher untuk bertanya, bertukar referensi, dan bertumbuh bersama.</p>
              <ul><li>Diskusi tanpa gatekeeping</li><li>Etika sebagai standar</li></ul>
            </article>
            <div class="signal-panel">
              <span class="signal-mark" aria-hidden="true"><i></i><i></i><i></i><i></i><b></b></span>
              <div class="signal-copy"><span>OUR SIGNAL</span><strong>EXPLORE<br />LEARN<br />SECURE</strong></div>
            </div>
          </div>
        </div>
      </section>

      <section id="materi" class="section-pad insights-section full-bleed-section">
        <div class="container wide-container">
          <div class="section-title reveal">
            <div>
              <p class="eyebrow"><span></span>Latest Insights</p>
              <h2>Materi ringkas, arah praktik jelas.</h2>
            </div>
            <p>Materi ringkas dari kanal edukasi SpectraSec untuk membangun dasar teknis sebelum masuk ke praktik security research.</p>
          </div>
          <div class="insights-grid">
            {insights.map((item) => (
              <button class={`insight-card magnetic ${item.className}`} data-insight-title={item.title} data-insight-category={item.category} data-insight-body={item.body}>
                <span class="card-scanline" aria-hidden="true"></span>
                <div class="insight-overlay"></div>
                <div class="insight-top"><span>{item.number} / {item.category}</span><span class="insight-icon">{item.icon}</span></div>
                <div class="insight-bottom"><h3>{item.title}</h3><p>{item.excerpt}</p><span class="read-link">BACA RINGKASAN ›</span></div>
              </button>
            ))}
          </div>
        </div>
      </section>

      <section id="tim" class="section-pad team-section full-bleed-section">
        <div class="container wide-container">
          <div class="section-title reveal">
            <div>
              <p class="eyebrow"><span></span>Core Members</p>
              <h2>Core team dengan rekam jejak riset.</h2>
            </div>
            <p>Anggota inti yang menggerakkan riset, materi, diskusi, dan praktik responsible disclosure di lingkungan SpectraSec.</p>
          </div>
          <div class="team-grid">
            {members.map((member, index) => (
              <article id={slug(member.name)} class={`member-card magnetic ${index === 0 ? "member-featured" : ""}`}>
                <span class="card-scanline" aria-hidden="true"></span>
                <div class="member-portrait">
                  {member.image ? (
                    <img src={member.image} alt={`Foto ${member.name}`} style={`object-position:${member.position ?? "center center"}`} width="720" height="720" loading={index < 2 ? "eager" : "lazy"} decoding="async" />
                  ) : (
                    <div class="member-monogram"><span class="signal-mark" aria-hidden="true"><i></i><i></i><i></i><i></i><b></b></span><strong>{member.initials}</strong><span>PHOTO PENDING VERIFICATION</span></div>
                  )}
                  <span class="member-number">{String(index + 1).padStart(2, "0")}</span>
                  {member.credit && <small class="photo-credit">{member.credit}</small>}
                </div>
                <div class="member-body">
                  <div class="member-heading">
                    <p class="member-role">{member.role}</p>
                    <h3>{member.name}</h3>
                  </div>
                  <p class="member-summary">{member.summary}</p>
                  <div class="member-tags">{member.tags.map((tag) => <span>{tag}</span>)}</div>
                  <div class="member-achievements" aria-label={`Pencapaian ${member.name}`}>
                    {member.achievements.map((achievement) => <span>{achievement}</span>)}
                  </div>
                  <div class="member-links">
                    {member.links.map(([label, href]) => <a class="magnetic" href={href} target="_blank" rel="noreferrer">{label} ↗</a>)}
                  </div>
                </div>
              </article>
            ))}
          </div>
          <p class="team-note">Profil memakai sumber profesional dan publik yang dapat dicocokkan. Foto yang belum terverifikasi ditandai dan tidak digantikan dengan wajah dari hasil pencarian homonim.</p>
        </div>
      </section>

      <section id="instruktur" class="section-pad instructor-section full-bleed-section">
        <div class="container wide-container instructor-grid">
          <div class="instructor-visual magnetic">
            <img src="/images/security-research-desk.webp" alt="Meja riset keamanan dengan visualisasi jaringan dan catatan threat model" width="1200" height="800" loading="lazy" decoding="async" />
            <div class="instructor-scan"></div>
            <div class="profile-stamp"><span>SS</span><small>OFFICIAL<br />INSTRUCTOR</small></div>
          </div>
          <div class="instructor-copy">
            <p class="eyebrow"><span></span>Official Instructor</p>
            <h2>Belajar langsung dari praktisi yang memahami lapangan.</h2>
            <p class="handle">@ouashxy</p>
            <p>Instruktur resmi SpectraSec.id yang memandu komunitas memahami mindset security researcher: teliti saat mengamati, sistematis saat menguji, dan bertanggung jawab saat melaporkan.</p>
            <div class="expertise">
              <span>Ethical Hacking</span>
              <span>Web Security</span>
              <span>Vulnerability Research</span>
            </div>
            <a class="magnetic" href={instagramUrl} target="_blank" rel="noreferrer">Lihat aktivitas di Instagram ↗</a>
          </div>
        </div>
      </section>

      <section class="cta-section">
        <div class="cta-rings"></div>
        <div class="container cta-inner">
          <p class="eyebrow light"><span></span>Build Your Cyber Foundation</p>
          <h2>Siap memperkuat<br />pertahanan digital?</h2>
          <p>Masuk ke ruang belajar yang membahas cybersecurity dengan bahasa yang jelas, praktik yang terarah, dan batas etika yang tegas.</p>
          <div class="hero-actions centered">
            <a class="btn-primary magnetic" href={telegramUrl} target="_blank" rel="noreferrer">Gabung Komunitas</a>
            <a class="btn-secondary magnetic" href={instagramUrl} target="_blank" rel="noreferrer">@spectrasec.id</a>
          </div>
        </div>
      </section>
    </main>

    <footer>
      <div class="container footer-main">
        <div><a class="brand" href="#top"><img class="brand-logo" src="/images/spectrasec-logo.jpg" alt="" width="64" height="64" loading="lazy" decoding="async" /><span>SPECTRASEC<span>.ID</span></span></a><p>Komunitas belajar dan media edukasi keamanan cyber Indonesia.</p></div>
        <div class="footer-links"><span>NAVIGASI</span><a class="magnetic" href="#tentang">Tentang</a><a class="magnetic" href="#materi">Insight</a><a class="magnetic" href="#tim">Tim</a><a class="magnetic" href="#instruktur">Instruktur</a></div>
        <div class="footer-links"><span>TERHUBUNG</span><a class="magnetic" href={instagramUrl} target="_blank" rel="noreferrer">Instagram ↗</a><a class="magnetic" href={telegramUrl} target="_blank" rel="noreferrer">Telegram ↗</a></div>
      </div>
      <div class="container footer-bottom"><p>© 2026 SpectraSec.id</p><p>Seluruh materi ditujukan untuk edukasi dan praktik ethical hacking yang legal.</p></div>
    </footer>

    <div class="modal-backdrop" data-modal hidden>
      <article class="insight-modal" role="dialog" aria-modal="true" aria-label="Ringkasan insight">
        <button class="modal-close" data-modal-close aria-label="Tutup ringkasan">×</button>
        <p class="eyebrow"><span></span><span data-modal-category></span></p>
        <h2 data-modal-title></h2>
        <p data-modal-body></p>
        <div class="modal-note"><span>Praktikkan hanya pada lab, sistem milik sendiri, atau target dengan izin dan scope yang jelas.</span></div>
        <a href={instagramUrl} target="_blank" rel="noreferrer">Temukan materi lengkap ↗</a>
      </article>
    </div>

    <script is:inline>
      const header = document.querySelector("[data-header]");
      const menuButton = document.querySelector("[data-menu-button]");
      const mobileNav = document.querySelector("[data-mobile-nav]");
      const modal = document.querySelector("[data-modal]");
      const modalTitle = document.querySelector("[data-modal-title]");
      const modalCategory = document.querySelector("[data-modal-category]");
      const modalBody = document.querySelector("[data-modal-body]");

      const updateHeader = () => {
        const y = Math.max(0, window.scrollY);
        header?.classList.toggle("is-scrolled", y > 24);
        header?.classList.toggle("is-compact", y > 70);
      };

      let scrollFrame = 0;
      window.addEventListener("scroll", () => {
        if (scrollFrame) return;
        scrollFrame = window.requestAnimationFrame(() => {
          updateHeader();
          scrollFrame = 0;
        });
      }, { passive: true });
      updateHeader();

      menuButton?.addEventListener("click", () => {
        const next = mobileNav?.hasAttribute("hidden");
        if (next) mobileNav?.removeAttribute("hidden");
        else mobileNav?.setAttribute("hidden", "");
        menuButton.setAttribute("aria-expanded", String(next));
      });
      mobileNav?.querySelectorAll("a").forEach((link) => link.addEventListener("click", () => {
        mobileNav.setAttribute("hidden", "");
        menuButton?.setAttribute("aria-expanded", "false");
      }));

      document.querySelectorAll("[data-insight-title]").forEach((card) => {
        card.addEventListener("click", () => {
          if (modalTitle) modalTitle.textContent = card.getAttribute("data-insight-title") || "";
          if (modalCategory) modalCategory.textContent = card.getAttribute("data-insight-category") || "";
          if (modalBody) modalBody.textContent = card.getAttribute("data-insight-body") || "";
          modal?.removeAttribute("hidden");
          document.body.style.overflow = "hidden";
        });
      });

      const closeModal = () => {
        modal?.setAttribute("hidden", "");
        document.body.style.overflow = "";
      };
      document.querySelector("[data-modal-close]")?.addEventListener("click", closeModal);
      modal?.addEventListener("mousedown", (event) => {
        if (event.target === modal) closeModal();
      });
      window.addEventListener("keydown", (event) => {
        if (event.key === "Escape" && modal && !modal.hasAttribute("hidden")) closeModal();
      });

      if (!window.matchMedia("(hover: none)").matches) {
        document
          .querySelectorAll(".magnetic, .value-panel, .insight-card, .member-card, .instructor-visual")
          .forEach((el) => {
            let frame = 0;
            const strong = el.matches(".btn-primary, .btn-secondary, .header-cta, .desktop-nav a, .member-links a, .footer-links a, .instructor-copy a");
            const strength = strong ? 0.12 : 0.026;

            const applyPointer = (event) => {
              const pointer = event;
              window.cancelAnimationFrame(frame);
              frame = window.requestAnimationFrame(() => {
                const rect = el.getBoundingClientRect();
                const x = (pointer.clientX - (rect.left + rect.width / 2)) * strength;
                const y = (pointer.clientY - (rect.top + rect.height / 2)) * strength;
                const glowX = ((pointer.clientX - rect.left) / rect.width) * 100;
                const glowY = ((pointer.clientY - rect.top) / rect.height) * 100;
                const tiltX = (50 - glowY) * (strong ? 0 : 0.07);
                const tiltY = (glowX - 50) * (strong ? 0 : 0.055);
                el.style.setProperty("--hover-x", `${x.toFixed(2)}px`);
                el.style.setProperty("--hover-y", `${y.toFixed(2)}px`);
                el.style.setProperty("--glow-x", `${glowX.toFixed(2)}%`);
                el.style.setProperty("--glow-y", `${glowY.toFixed(2)}%`);
                el.style.setProperty("--tilt-x", `${tiltX.toFixed(2)}deg`);
                el.style.setProperty("--tilt-y", `${tiltY.toFixed(2)}deg`);
              });
            };

            el.addEventListener("pointerenter", (event) => {
              el.classList.add("is-hovering");
              applyPointer(event);
            }, { passive: true });

            el.addEventListener("pointermove", applyPointer, { passive: true });

            el.addEventListener("pointerleave", () => {
              window.cancelAnimationFrame(frame);
              el.classList.remove("is-hovering");
              el.style.setProperty("--hover-x", "0px");
              el.style.setProperty("--hover-y", "0px");
              el.style.setProperty("--glow-x", "50%");
              el.style.setProperty("--glow-y", "35%");
              el.style.setProperty("--tilt-x", "0deg");
              el.style.setProperty("--tilt-y", "0deg");
            }, { passive: true });
          });
      }
    </script>
  </body>
</html>
