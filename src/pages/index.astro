    tags: ["Google Cloud", "Bugcrowd", "XSS"],
    achievements: ["WHO XSS report", "SURF Hall of Fame", "EMBL-EBI CVD", "University HoF", "Google Cloud Skills", "Bugcrowd researcher"],
